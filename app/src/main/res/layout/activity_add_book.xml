<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM SÁCH MỚI"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#00796B"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm một cuốn sách vào thư viện của bạn"
            android:textSize="14sp"
            android:textColor="#78909C"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên sách *"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#263238" />

        <EditText
            android:id="@+id/edtBookTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: Đắc nhân tâm"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:textSize="16sp"
            android:padding="12dp"
            android:backgroundTint="#00796B"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tác giả *"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/edtBookAuthor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ví dụ: Dale Carnegie"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textSize="16sp"
            android:padding="12dp"
            android:backgroundTint="#00796B"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thể loại"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:layout_marginTop="20dp" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#00796B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tình trạng đọc"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:checkedButton="@id/rbUnread">

            <RadioButton
                android:id="@+id/rbUnread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa đọc"
                android:textSize="15sp"
                android:buttonTint="#00796B"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbReading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang đọc"
                android:textSize="15sp"
                android:buttonTint="#00796B" />

            <RadioButton
                android:id="@+id/rbRead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã đọc"
                android:textSize="15sp"
                android:buttonTint="#00796B" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đánh giá"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp" />

        <RatingBar
            android:id="@+id/ratingBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="0"
            android:progressTint="#FFB300"
            android:secondaryProgressTint="#FFE082" />

        <TextView
            android:id="@+id/tvRatingValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 5 sao"
            android:textSize="14sp"
            android:textColor="#78909C"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/edtBookNote"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:hint="Nhập ghi chú về cuốn sách..."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:minLines="3"
            android:padding="12dp"
            android:textSize="15sp"
            android:backgroundTint="#00796B" />

        <Button
            android:id="@+id/btnSaveBook"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:text="Lưu sách"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00796B" />

    </LinearLayout>

</ScrollView>
